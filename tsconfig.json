{
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "declaration": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@domain": ["./src/domain"],
      "@domain/*": ["./src/domain/*"],
      "@infra": ["./src/infra"],
      "@infra/*": ["./src/infra/*"],
      "@utils": ["./src/utility"],
      "@utils/*": ["./src/utility/*"],
      "@hooks": ["./src/utility/hooks"],
      "@hooks/*": ["./src/utility/hooks/*"],
      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"],
      "@@/*": ["./src/.umi/*"],
      "@@test/*": ["./src/.umi-test/*"],
      "@root/*": ["./*"]
    }
  },
  "include": ["./**/*.d.ts", "./**/*.ts", "./**/*.tsx"]
}
