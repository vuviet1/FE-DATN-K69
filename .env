# ===================================================================
# CẤU HÌNH KẾT NỐI BACKEND API (BE) - MẠNG XÃ HỘI HỌC TẬP
# ===================================================================

# 1. ĐỊA CHỈ MÁY CHỦ BACKEND (Dùng cho Dev Proxy)
# Nhập địa chỉ URL và cổng mà server Backend của bạn đang chạy
# Ví dụ: http://localhost:8080 (Spring Boot), http://localhost:5000 (Express/Nest), http://localhost:3000
BACKEND_URL=http://localhost:8080

# 2. BASE URL CHO API CLIENT (Tùy chọn)
# Để trống để tự động proxy qua dev server, tránh lỗi CORS
UMI_APP_API_BASE_URL=

# 3. CHẾ ĐỘ MOCK DỮ LIỆU CỦA FRONTEND
# Bỏ comment dòng dưới để tắt hoàn toàn Mock và gọi thẳng vào Backend thật:
# MOCK=none

# 4. TÙY CHỈNH ENDPOINT XÁC THỰC
# Khớp với Route/Controller bên Backend của bạn:
UMI_APP_API_LOGIN_PATH=/api/login/account
UMI_APP_API_REGISTER_PATH=/api/register
UMI_APP_API_CURRENT_USER_PATH=/api/currentUser
